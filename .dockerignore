# Allowlist: only what the API image needs reaches the build context.
*
!pyproject.toml
!uv.lock
!api/pyproject.toml
!api/src
!packages/fraud-core/pyproject.toml
!packages/fraud-core/src
!training/pyproject.toml
!models
# Legacy bundles pickle scikit-learn objects the image cannot load; their repackaged versions are served.
models/*/preprocessor.joblib
**/__pycache__
